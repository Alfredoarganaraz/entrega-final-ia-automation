    {
      "parameters": {
        "jsCode": "// Traigo los registros del RAG (vienen del nodo Search records)\nconst registros = $input.all();\n\n// Armo un bloque de texto con todo el conocimiento recuperado\nlet contexto = \"\";\nfor (const item of registros) {\n  const f = item.json.fields;\n  contexto += `### ${f['Título']} (${f['Categoría']})\\n${f['Contenido']}\\n\\n`;\n}\n\n// Traigo los datos de la fila original que disparó el flujo\nconst filaOriginal = $('Airtable Trigger').item.json;\nconst idea = filaOriginal.fields['Idea Semilla'];\nconst tema = filaOriginal.fields['Tema'];\nconst tono = filaOriginal.fields['Tono'];\nconst recordId = filaOriginal.id;\n\n// Devuelvo todo junto y listo para la IA\nreturn [{\n  json: {\n    recordId: recordId,\n    idea: idea,\n    tema: tema,\n    tono: tono,\n    contexto: contexto.trim()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        112
      ],
      "id": "a8091885-67e9-47c2-bef9-80f82f71aff4",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"max_tokens\": 1000,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sos el redactor de contenido de Nexo Contable, un estudio contable argentino. Tu UNICA fuente de verdad es el CONTEXTO que te paso. Reglas estrictas: 1) No inventes datos, precios, plazos ni servicios: si un dato no esta en el contexto, no lo menciones. 2) Respeta el tono de marca (voseo rioplatense, cercano, didactico). 3) Escribi un post de LinkedIn de 150 a 200 palabras. 4) Cerra siempre con una pregunta abierta al lector. 5) Maximo 2 emojis. Devolve SOLO el texto del post, sin comillas ni titulos ni explicaciones.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(\"IDEA SEMILLA: \" + $json.idea + \"\\n\\nTONO: \" + $json.tono + \"\\n\\nCONTEXTO:\\n\" + $json.contexto) }}\n    }\n  ]\n}",
        "options": {}
